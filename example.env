# Postgres of docker-compose.dev.yaml and core-api
DB_USERNAME=pg
DB_PASSWORD=pgpw

# core-api: application (spring-boot:run and the jar), build of the image and docker-compose.yaml
JDBC_URL=jdbc:postgresql://localhost:5432/core_api
CORS_ALLOWED_ORIGINS=http://localhost:5173
# JWKS URL of the token issuer and the audience (aud) the tokens must contain
JWT_JWK_SET_URI=
JWT_AUDIENCE=
JWT_ISSUER=
JWT_ORGANIZATION_CLAIM=organization
# API key of the provider of the AI model (today DeepSeek)
AI_API_KEY=
# Build of the dashboard image. The dashboard of development reads dashboard/.env instead.
# Written into the build: the API and the issuer of the OpenID Connect provider as the browser reaches them, without
# the / at the end
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
# Add the origin of the dashboard to CORS_ALLOWED_ORIGINS

REGISTRY=localhost:5000
