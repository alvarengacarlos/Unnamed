# Postgres of docker-compose.dev.yaml and core-api
DB_USERNAME=pg
DB_PASSWORD=pgpw

# core-api: application (spring-boot:run and the jar) and docker-compose.yaml. The build and the tests use Testcontainers.
JDBC_URL=jdbc:postgresql://localhost:5432/unnamed
CORS_ALLOWED_ORIGINS=http://localhost:5173
# JWKS URL of the token issuer and the audience (aud) the tokens must contain
JWT_JWK_SET_URI=
JWT_AUDIENCE=
JWT_ISSUER=
JWT_ORGANIZATION_CLAIM=organization
# dashboard of docker-compose.yaml. The dashboard of development reads dashboard/.env instead.
# Written into the build: the API and the issuer of the OpenID Connect provider as the browser reaches them, without
# the / at the end
VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
# Add the origin of the dashboard to CORS_ALLOWED_ORIGINS
