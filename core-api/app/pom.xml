<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.alvarengacarlos</groupId>
        <artifactId>unnamed</artifactId>
        <version>0.0.1</version>
    </parent>
    <groupId>com.alvarengacarlos.unnamed</groupId>
    <artifactId>app</artifactId>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                    <systemPropertyVariables>
                        <DOTENV_FILE>${dotenv.file}</DOTENV_FILE>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!--
                Starts a throwaway Postgres in Docker, applies the Liquibase changelog and generates the jOOQ classes
                from it, so the build needs Docker but no database of its own.
                The plugin was released with Testcontainers 1.19, which Docker Engine 29+ rejects (API too old), and
                with jOOQ 3.18, so both are overridden with the versions this project uses.
            -->
            <plugin>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-jooq-codegen-maven-plugin</artifactId>
                <version>0.0.4</version>
                <dependencies>
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>testcontainers</artifactId>
                        <version>${codegen.testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>jdbc</artifactId>
                        <version>${codegen.testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.testcontainers</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${codegen.testcontainers.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>${postgresql.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-codegen</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <id>jooq-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <database>
                                <type>POSTGRES</type>
                                <containerImage>${postgres.image}</containerImage>
                            </database>
                            <liquibase>
                                <changeLogPath>src/main/resources/db/root-changelog.yaml</changeLogPath>
                            </liquibase>
                            <jooq>
                                <generator>
                                    <database>
                                        <name>org.jooq.meta.postgres.PostgresDatabase</name>
                                        <inputSchema>public</inputSchema>
                                        <excludes>databasechangelog|databasechangeloglock</excludes>
                                        <forcedTypes>
                                            <!-- Audit timestamps are instants; event times (when, start/end) stay local. -->
                                            <forcedType>
                                                <name>INSTANT</name>
                                                <includeExpression>.*\.(created_at|updated_at)</includeExpression>
                                            </forcedType>
                                            <forcedType>
                                                <userType>com.alvarengacarlos.unnamed.app.member.Member.Gender</userType>
                                                <enumConverter>true</enumConverter>
                                                <includeExpression>members\.gender</includeExpression>
                                            </forcedType>
                                            <forcedType>
                                                <userType>com.alvarengacarlos.unnamed.app.clazz.Clazz.MartialArt</userType>
                                                <enumConverter>true</enumConverter>
                                                <includeExpression>clazzes\.martial_art</includeExpression>
                                            </forcedType>
                                            <forcedType>
                                                <userType>com.alvarengacarlos.unnamed.app.common.PaymentMethod</userType>
                                                <enumConverter>true</enumConverter>
                                                <includeExpression>.*\.payment_method</includeExpression>
                                            </forcedType>
                                            <forcedType>
                                                <userType>java.time.Month</userType>
                                                <enumConverter>true</enumConverter>
                                                <includeExpression>tuition_payments\.month</includeExpression>
                                            </forcedType>
                                            <forcedType>
                                                <userType>com.alvarengacarlos.unnamed.app.tournament.Tournament.TournamentFormat</userType>
                                                <enumConverter>true</enumConverter>
                                                <includeExpression>tournaments\.format</includeExpression>
                                            </forcedType>
                                            <forcedType>
                                                <userType>com.alvarengacarlos.unnamed.app.tournamentmatch.TournamentMatch.TournamentMatchResult</userType>
                                                <enumConverter>true</enumConverter>
                                                <includeExpression>tournament_matches\.result</includeExpression>
                                            </forcedType>
                                        </forcedTypes>
                                    </database>
                                    <generate>
                                        <javaTimeTypes>true</javaTimeTypes>
                                    </generate>
                                    <target>
                                        <packageName>com.alvarengacarlos.unnamed.app.jooq</packageName>
                                    </target>
                                </generator>
                            </jooq>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
