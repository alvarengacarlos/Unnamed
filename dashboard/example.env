# Copy to .env (cp example.env .env). Vite writes the VITE_* variables into the build.
VITE_API_BASE_URL=http://localhost:8080
# The OpenID Connect provider that opens the session: its issuer, without the / at the end, and the id of the public
# client of the dashboard
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=

# Only for the e2e tests against the real backend (E2E_MOCK_API=false): the user who logs in on the provider. Use a user
# only for the tests: they create and delete records in its organization.
E2E_USERNAME=
E2E_PASSWORD=
# Optional: the address of the app, http://localhost:5173 by default
# E2E_BASE_URL=
